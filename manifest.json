{
	"manifest_version": 3,
	"name": "Sudoku Solution Finder",
	"description": "A Chrome extension to find solutions for Sudoku puzzles.",
	"version": "1.0",
	"content_scripts": [
		{
			"matches": [
				"https://www.nytimes.com/puzzles/sudoku/*",
				"https://sudoku.com/"
			],
			"js": ["scripts/content.js", "scripts/solveSudoku.js"],
			"css": ["styles/content.css"]
		}
	]
}
